NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side. Está en Project Settings > API > service_role. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app, usada para armar el link de invitación. En prod: https://tu-dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secreto que Vercel Cron manda como "Authorization: Bearer ..." al pegarle a
# /api/cron/revisar-vencimientos. Configuralo también como env var del
# proyecto en Vercel (Project Settings > Environment Variables) — Vercel lo
# agrega solo al header en cada corrida del cron si coincide el nombre.
CRON_SECRET=
